---
import Layout from '../layouts/Layout.astro';
import GetSessionPrompt from '../components/getSessionPrompt.jsx';
import Navbar from '../components/Navbar.astro';

// I wanna go for this kinda vibe: https://codepen.io/elujambio/pen/YLMVed

export const prerender = true;
---

<Layout
	title="Aspine"
	description="Aspen, reborn. More features, better UI, and a team that is for students, by students."
	favicon="/favicon.svg"
	bodyClasses="bg-black text-[#e5eae7] overflow-hidden"
>
	<script>
		if (document.cookie) {
			if (
				document.cookie
					.split('; ')
					.find(row => row.startsWith('JSESSIONID='))
					?.split('=')[1]
			) {
				window.location.href = '/dash';
			}
		}
	</script>

	<main class="px-safe">
		<Navbar />
		<div
			class="flex flex-col mx-auto my-[5vh] pt-20 items-center justify-center"
		>
			<div
				class="flex flex-col my-[5rem] p-[2rem] border-gradient-4 w-[30rem] h-[30rem] rounded-[32px]"
			>
				<p>
					<!-- YO LEAVE THIS AS IS FOR A BIT UNTIL I TOUCH IT -HENRY -->
					Lorem ipsum dolor sit amet consectetur adipisicing elit. Dignissimos
					illo quia eum soluta recusandae, consectetur odit iure et blanditiis
					dolores, rem in consequuntur fuga non, dolor voluptatem quod.
					Ducimus, unde?
				</p>

				<!-- <GetSessionPrompt client:load /> -->
			</div>
		</div>
	</main>
	<!-- <span class="numberText text-9xl font-[Satoshi-Bold]">Login</span> -->

	<div
		class="blob -z-50 blur-[128px] w-2/5 h-96 bg-[#48c288] absolute -right-64 top-[75vh] rounded-full"
	>
	</div>

	<div
		class="w-[200vw] bottomBlur blur-[128px] h-[145vh] bg-black rounded-full absolute left-1/2 -translate-x-1/2 bottom-0 translate-y-[165vh] -z-10"
	>
	</div>

	<!--
			client:only="preact" if it doesnt need to render on the server.
			This only needs to render on the server because I made it append the
			session id to a div. Thats only for testing obv
		-->
</Layout>
