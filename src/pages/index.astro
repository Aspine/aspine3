---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.jsx';
import Navbar from '../components/Navbar.astro';

/**
	astro preferences disable devToolbar
	(for lighthouse in dev)
*/
export const prerender = true;
---

<Layout
	title="Aspine"
	description="Aspen, reborn. More features, better UI, and a team that is for students, by students."
	favicon="/favicon.svg"
	bodyClasses="bg-black text-[#e5eae7] overflow-hidden"
>
	<main class="px-safe">
		<Navbar />
		<div
			class="flex flex-col mx-auto my-[5vh] pt-20 items-center justify-center"
		>
			<h1
				class="mx-auto text-center max-w-[80vw] font-['Satoshi-Black'] text-[#fff] text-3xl mt-0 md:mt-0 2xl:text-8xl xl:text-8xl lg:text-7xl md:text-5xl left-1/2 2xl:mt-[10vh] xl:mt-10 lg:mt-8 md:m-8 mb-4 2xl:mb-8 xl:mb-8 lg:mb-8"
			>
				Welcome to<span class="text-[#4ade80] heroText"
					>&nbsp;Aspine <span class="heroText font-[Satoshi-Italic]"
						>v3</span
					></span
				><br />
				<span class="font-[Satoshi-Black]">Aspen</span>, <span
					class="heroText2 font-[Satoshi-LightItalic]">reborn</span
				>
				<br />
			</h1>
			<p
				class="xl:text-lg lg:text-base md:text-sm my-4 text-center font-[Satoshi-BoldItalic] text-[#ffffff8e] hidden md:unhidden"
			>
				More features, better UI, and a team that is for students, by
				students.
			</p>
			<p
				class="xl:text-lg hidden md:unhidden lg:text-base md:text-sm text-center my-4 font-[Satoshi-Light] text-[#ffffff75] max-w-2xl"
			>
				Aspine has been a major part of student quality of life at CRLS.
				Aspine v3 combines the speed of modern tools, and the features
				of the original Aspine. Aspine v3 is the faster, cleaner and
				more modern Aspen.
			</p>
			<div
				class="translate-y-2 space-x-6 text-sm tracking-widest hidden md:unhidden md:flex"
			>
				<a
					href="/dash"
					class="border-gradient-2 getStarted rounded-full border-0 px-12 py-3 font-[Satoshi-Bold] content-center"
					>GET STARTED</a
				>
				<a
					href="/hdiw"
					class="button font-[Satoshi-Bold] rounded-full hdiw"
				>
					<div class="blob1"></div>
					<div class="blob2"></div>
					<div
						class="inner-button px-12 py-3 font-[Satoshi-Bold] content-center"
					>
						HOW DOES IT WORK?
					</div>
				</a>
			</div>
			<div
				class="space-x-6 text-sm xl:w-80 tracking-widest 2xl:hidden flex md:hidden"
			>
				<a
					href="/login"
					class="button font-[Satoshi-Bold] rounded-full"
				>
					<div class="blob1"></div>
					<div class="blob2"></div>
					<div
						class="inner-button px-12 font-[Satoshi-Bold] content-center"
					>
						LOGIN
					</div>
				</a>
				<a
					href="https://github.com/aspine/aspine3"
					class="cursor-pointer text-white bg-gradient-to-r from-gray-800 to-black rounded-full border-2 border-gray-600 duration-300 hover:text-gray-500 hover:border-gray-700 hover:from-gray-900 hover:to-black px-12 py-3 font-[Satoshi-Bold] content-center"
					>GITHUB
				</a>
			</div>
		</div>

		<div
			class="blob -z-50 blur-[10vh] md:blur-[5vw] w-2/5 h-96 bg-[#48c288] absolute right-1 md:-right-64 top-[75vh] rounded-full"
		>
		</div>

		<div
			class="w-[200vw] bottomBlur hidden md:unhidden blur-[128px] h-[145vh] bg-[black] rounded-full absolute left-1/2 -translate-x-1/2 bottom-0 translate-y-[165vh] -z-10"
		>
		</div>
		<!--
			<ThemeToggle client:only="preact" />
		-->
	</main>
</Layout>
