---
import Layout from '../layouts/Layout.astro';
import GetGrades from '../components/GetGrades.jsx';
---

<Layout
	title="Aspine - Dashboard"
	description="Aspen, reborn. More features, better UI, and a team that is for students, by students."
	favicon="/favicon.svg"
	bodyClasses="bg-[var(--bg-color)] text-[var(--secondary-color)] overflow-x-hidden"
>
	<a href="/"><button>shut up leo</button></a>

	<GetGrades client:load jsessionId={undefined} />

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			if (!document.cookie) {
				window.location.href = '/login';
				return;
			}

			const jsessionId = document.cookie
				.split('; ')
				.find(row => row.startsWith('JSESSIONID='))
				?.split('=')[1];

			if (!jsessionId) {
				console.error(
					'No JSESSIONID found, redirecting to login page...'
				);
				window.location.href = '/login';
				return;
			}

			window.jsessionId = jsessionId;

			const getGradesComponent = document.querySelector('get-grades');
			if (getGradesComponent) {
				// not being passed to jsx, need to reload jsx island after jsessionid is defined
				getGradesComponent.setAttribute('jsessionId', jsessionId);
			}
		});
	</script>
</Layout>
