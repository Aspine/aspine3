---
import Layout from '../layouts/Layout.astro';
import GetInfo from '../components/GetInfo.jsx';
import Navbar from '../components/Dashbar.astro';
---

<Layout
	title="Aspine - Dashboard"
	description="Aspen, reborn. More features, better UI, and a team that is for students, by students."
	favicon="/favicon.svg"
	bodyClasses="bg-black text-white overflow-x-hidden"
>
	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const cookieString = document.cookie;
			if (!cookieString) {
				console.error('No cookies found, redirecting to login page...');
				window.location.href = '/login';
				return;
			}

			const jsessionId = cookieString
				.split('; ')
				.find(row => row.startsWith('JSESSIONID='))
				?.split('=')[1];

			if (!jsessionId) {
				console.error(
					'No JSESSIONID found, redirecting to login page...'
				);
				window.location.href = '/login';
				return;
			}
		});
	</script>

	<Navbar />

	<div class="h-[calc(100vh-100px)] w-screen flex gap-4 p-4 mt-[100px]">
		<div class="w-1/2 flex flex-col gap-4 flex-grow">
			<div class="h-1/2 border-gradient-4 p-4 rounded-[16px]">
				<GetInfo client:load callType="grades" />
			</div>
			<div class="h-1/2 flex-grow border-gradient-4 p-4 rounded-[16px]">
				<GetInfo client:load callType="teachers" />
			</div>
		</div>

		<div class="w-1/2 flex flex-col gap-4 flex-grow">
			<div class="h-2/3 flex-grow border-gradient-4 p-4 rounded-[16px]">
				<GetInfo client:load callType="attendance" />
			</div>
			<div class="h-1/3 flex-grow border-gradient-4 p-4 rounded-[16px]">
				CALANDER
			</div>
		</div>
	</div>
</Layout>
