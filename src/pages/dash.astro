---
import Layout from '../layouts/Layout.astro';
import GetInfo from '../components/GetInfo.jsx';
import Navbar from '../components/Dashbar.astro';
---

<Layout
	title="Aspine - Dashboard"
	description="Aspen, reborn. More features, better UI, and a team that is for students, by students."
	favicon="/favicon.svg"
	bodyClasses="bg-black text-white overflow-x-hidden"
>
	<Navbar />

	<div class="dash-container">
		<div class="dash-container-in">
			<div class="dash-schedule">hello world</div>
			<div class="dash-reports">hello worldd</div>
		</div>
		<div class="dash-container-in"></div>
	</div>
	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const cookieString = document.cookie;
			if (!cookieString) {
				console.error('No cookies found, redirecting to login page...');
				window.location.href = '/login';
				return;
			}

			const jsessionId = cookieString
				.split('; ')
				.find(row => row.startsWith('JSESSIONID='))
				?.split('=')[1];

			if (!jsessionId) {
				console.error(
					'No JSESSIONID found, redirecting to login page...'
				);
				window.location.href = '/login';
				return;
			}
		});
	</script>
	<br />
	<br />
	<br />
	<br />
	<GetInfo client:load callType="grades" />
	<br />
	<GetInfo client:load callType="courses" />
	<br />
	<GetInfo client:load callType="length" />
	<br />
	<GetInfo client:load callType="roomNumbers" />
	<br />
	<GetInfo client:load callType="startDate" />
	<br />
	<GetInfo client:load callType="teachers" />
	<br />
	<GetInfo client:load callType="attendance" />
</Layout>
